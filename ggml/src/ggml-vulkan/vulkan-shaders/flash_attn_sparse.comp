#version 450

// [fork] DSA sparse flash attention (see ggml.c ggml_flash_attn_ext_set_sparse).
//
// One workgroup processes ONE query token and a chunk of HCHUNK query heads.
// K/V rows are staged to LDS once per chunk and consumed by every head (MQA:
// all heads share the same rows — the dense FA shaders cannot exploit this
// once every token carries its own top-k index list).
//
// Two segments share one online softmax per head:
//   segment 0 (dense):    rows 0..ne_dense of K with the f16 mask
//   segment 1 (gathered): rows kc[idx[j,t]] valid iff 0 <= idx[j,t] < nvis[t]
// V is the DV-prefix of the same staged row (MLA: V aliases K).
//
// Mirrors ggml-cuda/fattn-sparse.cu; keep the two in sync.
//
// Thread mapping, v2 (the v1 mapping ran at 1.36 TFLOPS against the dense FA
// shader's 4.89 at the same shape):
//
//   * lanes walk a K row with stride TPH, never in contiguous blocks. Each
//     lane reads 8 bytes, so a block mapping put all TPH lanes of a wave on
//     two LDS bank pairs — an 8-way conflict on every single K access, in
//     both the score and the accumulate loop. Striding spreads them over all
//     32 banks.
//   * each thread carries HPT heads in registers, so one LDS read of K feeds
//     HPT dot products. At HPT = 1 the kernel needs 1 byte of LDS per FLOP,
//     which is exactly the per-CU LDS:VALU ratio — i.e. LDS-bound even with
//     zero conflicts. HPT = 2 halves that and leaves the ALU the limit.
//   * K staging is a flat strided copy over the whole tile, so consecutive
//     threads take consecutive f16vec4 of one row: coalesced global reads and
//     conflict-free LDS writes (the per-row mapping had a 4-way write
//     conflict and 64-byte global bursts).

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable

#define WGS    256
#define TILE    32
#define TPH     16           // threads cooperating on one head's dot product
#define HPT      2           // heads carried per thread
#define HGRP   (WGS/TPH)     // head groups per workgroup (16)
#define HCHUNK (HGRP*HPT)    // query heads per workgroup (32)
#define DK     512
#define DV     512
#define D4     (DK/4)        // f16vec4 per row
#define DPT    (DK/TPH)      // dims per thread in the dot product (32)
#define VPT    (DV/TPH)      // dims per thread in the V accumulate (32)
#define V4     (DPT/4)       // f16vec4 per thread per row (8)
#define M_INIT (-1.0e30)

layout(local_size_x = WGS, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer Q    { float      data_q[];    };
layout (binding = 1) readonly buffer K    { f16vec4    data_k4[];   };
layout (binding = 2) readonly buffer M    { float16_t  data_m[];    };
layout (binding = 3) readonly buffer S    { float      data_s[];    };
layout (binding = 4) readonly buffer KC   { f16vec4    data_kc4[];  };
layout (binding = 5) readonly buffer IDX  { int        data_idx[];  };
layout (binding = 6) readonly buffer NVIS { int        data_nvis[]; };
layout (binding = 7) writeonly buffer O   { float      data_o[];    };

layout (push_constant) uniform parameter {
    float scale;
    uint  ne_dense;   // dense KV rows
    uint  n_idx;      // gathered candidates per token
    uint  n_head;
    uint  q_s1;       // Q strides in elements: token, head, stream
    uint  q_s2;
    uint  q_s3;
    uint  k_s1;       // dense K row / stream strides in elements
    uint  k_s3;
    uint  m_s1;       // mask token / stream strides in elements
    uint  m_s3;
    uint  c_s1;       // kc row / stream strides in elements
    uint  c_s3;
    uint  i_s1;       // idx token / stream strides in elements
    uint  i_s3;
    uint  n_s3;       // nvis stream stride in elements
    uint  flags;      // bit 0: has mask, bit 1: has sinks
} p;

shared f16vec4 Kt[TILE][D4];
shared float   Pt[HCHUNK][TILE];
shared uint    row_ok[TILE];
shared uint    row_src4[TILE];

void main() {
    const uint t   = gl_WorkGroupID.x;   // query token
    const uint hc  = gl_WorkGroupID.y;   // head chunk
    const uint s   = gl_WorkGroupID.z;   // stream
    const uint T   = gl_NumWorkGroups.x;

    const uint tid  = gl_LocalInvocationID.x;
    const uint hg   = tid / TPH;
    const uint lane = tid % TPH;

    const bool has_mask  = (p.flags & 1u) != 0u;
    const bool has_sinks = (p.flags & 2u) != 0u;

    // Q slice, pre-scaled. Lane l owns dims {(i*TPH + l)*4 + 0..3}, matching
    // the strided LDS walk below — which also makes this global read coalesced.
    uint  hh  [HPT];
    bool  h_ok[HPT];
    float Qr  [HPT][DPT];
    [[unroll]] for (uint u = 0; u < HPT; ++u) {
        const uint h = hc*HCHUNK + hg*HPT + u;
        hh  [u] = h;
        h_ok[u] = h < p.n_head;

        if (h_ok[u]) {
            const uint q_base = t*p.q_s1 + h*p.q_s2 + s*p.q_s3;
            [[unroll]] for (uint i = 0; i < V4; ++i) {
                const uint d0 = (i*TPH + lane)*4;
                [[unroll]] for (uint c = 0; c < 4; ++c) {
                    Qr[u][4*i + c] = data_q[q_base + d0 + c]*p.scale;
                }
            }
        } else {
            [[unroll]] for (uint i = 0; i < DPT; ++i) {
                Qr[u][i] = 0.0;
            }
        }
    }
    const bool grp_ok = h_ok[0];   // heads are consecutive: slot 0 valid => group has work

    float Or[HPT][VPT];
    [[unroll]] for (uint u = 0; u < HPT; ++u) {
        [[unroll]] for (uint i = 0; i < VPT; ++i) {
            Or[u][i] = 0.0;
        }
    }

    // running softmax state. Every lane of a head derives these from the same
    // cross-lane reductions, so they stay identical across the head's TPH lanes
    // and can live in registers instead of shared memory.
    float M_run  [HPT];
    float L_run  [HPT];
    float m_scale[HPT];
    [[unroll]] for (uint u = 0; u < HPT; ++u) {
        M_run  [u] = float(M_INIT);
        L_run  [u] = 0.0;
        m_scale[u] = 1.0;
    }

    const uint m_base = t*p.m_s1 + s*p.m_s3;
    const uint i_base = t*p.i_s1 + s*p.i_s3;
    const int  n_vis  = data_nvis[t + s*p.n_s3];

    const uint n_tiles_dense  = (p.ne_dense + TILE - 1)/TILE;
    const uint n_tiles_gather = (p.n_idx    + TILE - 1)/TILE;
    const uint n_tiles        = n_tiles_dense + n_tiles_gather;

    [[dont_unroll]] for (uint tile = 0; tile < n_tiles; ++tile) {
        const bool gather = tile >= n_tiles_dense;
        const uint base   = gather ? (tile - n_tiles_dense)*TILE : tile*TILE;
        const uint limit  = gather ? p.n_idx : p.ne_dense;

        // resolve each row's source and validity once, one thread per row
        if (tid < TILE) {
            bool ok   = base + tid < limit;
            uint src4 = 0u;
            if (ok) {
                if (gather) {
                    const int cell = data_idx[i_base + base + tid];
                    ok = cell >= 0 && cell < n_vis;
                    if (ok) {
                        src4 = (uint(cell)*p.c_s1 + s*p.c_s3)/4u;
                    }
                } else {
                    src4 = ((base + tid)*p.k_s1 + s*p.k_s3)/4u;
                }
            }
            row_ok  [tid] = ok ? 1u : 0u;
            row_src4[tid] = src4;
        }
        barrier();

        // stage TILE rows into LDS: flat strided copy, so a wave takes 32
        // consecutive f16vec4 of one row — one coalesced burst, no bank
        // conflicts, and r is wave-uniform so the row metadata is a scalar load
        [[unroll]] for (uint e = tid; e < TILE*D4; e += WGS) {
            const uint r = e/D4;
            if (row_ok[r] != 0u) {
                const uint c    = e%D4;
                const uint src4 = row_src4[r];
                Kt[r][c] = gather ? data_kc4[src4 + c] : data_k4[src4 + c];
            }
        }
        barrier();

        // scores: TPH lanes cooperate on each row's DK-dim dot product, and
        // each staged K value feeds HPT heads
        for (uint j = 0; j < TILE; ++j) {
            float sum[HPT];
            [[unroll]] for (uint u = 0; u < HPT; ++u) {
                sum[u] = 0.0;
            }

            if (grp_ok && row_ok[j] != 0u) {
                [[unroll]] for (uint i = 0; i < V4; ++i) {
                    const vec4 kv4 = vec4(Kt[j][i*TPH + lane]);
                    [[unroll]] for (uint u = 0; u < HPT; ++u) {
                        sum[u] += Qr[u][4*i + 0]*kv4.x + Qr[u][4*i + 1]*kv4.y
                                + Qr[u][4*i + 2]*kv4.z + Qr[u][4*i + 3]*kv4.w;
                    }
                }
            }

            [[unroll]] for (uint u = 0; u < HPT; ++u) {
                sum[u] += subgroupShuffleXor(sum[u], 8u);
                sum[u] += subgroupShuffleXor(sum[u], 4u);
                sum[u] += subgroupShuffleXor(sum[u], 2u);
                sum[u] += subgroupShuffleXor(sum[u], 1u);
            }

            if (lane == 0u) {
                // -inf mask entries flow through: exp(-inf - M) == 0 and
                // max() against M_INIT keeps M finite (no NaN paths)
                const bool  dead = row_ok[j] == 0u;
                const float bias = (!gather && has_mask) ? float(data_m[m_base + base + j]) : 0.0;
                [[unroll]] for (uint u = 0; u < HPT; ++u) {
                    Pt[hg*HPT + u][j] = dead ? uintBitsToFloat(0xFF800000) : sum[u] + bias;
                }
            }
        }
        barrier();

        // per-head online softmax update — the TPH lanes of a head split the
        // TILE rows between them, so every thread works (doing this on
        // thread<HCHUNK left 15/16 of the workgroup stalled at the barrier)
        [[unroll]] for (uint u = 0; u < HPT; ++u) {
            const uint slot = hg*HPT + u;

            float tmax = float(M_INIT);
            [[unroll]] for (uint j = lane; j < TILE; j += TPH) {
                tmax = max(tmax, Pt[slot][j]);
            }
            tmax = max(tmax, subgroupShuffleXor(tmax, 8u));
            tmax = max(tmax, subgroupShuffleXor(tmax, 4u));
            tmax = max(tmax, subgroupShuffleXor(tmax, 2u));
            tmax = max(tmax, subgroupShuffleXor(tmax, 1u));

            const float Mnew = max(M_run[u], tmax);
            const float ms   = exp(M_run[u] - Mnew);

            float l_add = 0.0;
            [[unroll]] for (uint j = lane; j < TILE; j += TPH) {
                const float pv = exp(Pt[slot][j] - Mnew);
                Pt[slot][j] = pv;
                l_add += pv;
            }
            l_add += subgroupShuffleXor(l_add, 8u);
            l_add += subgroupShuffleXor(l_add, 4u);
            l_add += subgroupShuffleXor(l_add, 2u);
            l_add += subgroupShuffleXor(l_add, 1u);

            M_run  [u] = Mnew;
            L_run  [u] = L_run[u]*ms + l_add;
            m_scale[u] = ms;
        }
        barrier();

        // accumulate O — each thread owns a VPT-dim slice of HPT heads
        [[unroll]] for (uint u = 0; u < HPT; ++u) {
            if (m_scale[u] != 1.0) {
                [[unroll]] for (uint i = 0; i < VPT; ++i) {
                    Or[u][i] *= m_scale[u];
                }
            }
        }
        for (uint j = 0; j < TILE; ++j) {
            if (row_ok[j] == 0u) {
                continue;
            }
            float pv[HPT];
            bool  live = false;
            [[unroll]] for (uint u = 0; u < HPT; ++u) {
                pv[u] = Pt[hg*HPT + u][j];
                live  = live || (pv[u] != 0.0);
            }
            if (!live) {
                continue;
            }
            [[unroll]] for (uint i = 0; i < V4; ++i) {
                const vec4 vv = vec4(Kt[j][i*TPH + lane]);
                [[unroll]] for (uint u = 0; u < HPT; ++u) {
                    Or[u][4*i + 0] += pv[u]*vv.x;
                    Or[u][4*i + 1] += pv[u]*vv.y;
                    Or[u][4*i + 2] += pv[u]*vv.z;
                    Or[u][4*i + 3] += pv[u]*vv.w;
                }
            }
        }
        barrier();
    }

    // dst is contiguous f32 [DV, n_head, T, ns]
    [[unroll]] for (uint u = 0; u < HPT; ++u) {
        if (!h_ok[u]) {
            continue;
        }

        // sinks — every lane of the head holds the same running state already
        float ms_f = 1.0;
        if (has_sinks) {
            const float sk   = data_s[hh[u]];
            const float Mnew = max(M_run[u], sk);
            ms_f     = exp(M_run[u] - Mnew);
            L_run[u] = L_run[u]*ms_f + exp(sk - Mnew);
        }

        const float li     = L_run[u] == 0.0 ? 0.0 : 1.0/L_run[u];
        const uint  o_base = DV*(hh[u] + p.n_head*(t + T*s));

        [[unroll]] for (uint i = 0; i < V4; ++i) {
            const uint d0 = (i*TPH + lane)*4;
            [[unroll]] for (uint c = 0; c < 4; ++c) {
                data_o[o_base + d0 + c] = Or[u][4*i + c]*ms_f*li;
            }
        }
    }
}
