#version 450

// [fork] DSA sparse flash attention (see ggml.c ggml_flash_attn_ext_set_sparse).
//
// One workgroup processes ONE query token and a chunk of HCHUNK query heads.
// K/V rows are staged to LDS once per chunk and consumed by every head (MQA:
// all heads share the same rows — the dense FA shaders cannot exploit this
// once every token carries its own top-k index list).
//
// Two segments share one online softmax per head:
//   segment 0 (dense):    rows 0..ne_dense of K with the f16 mask
//   segment 1 (gathered): rows kc[idx[j,t]] valid iff 0 <= idx[j,t] < nvis[t]
// V is the DV-prefix of the same staged row (MLA: V aliases K).
//
// Mirrors ggml-cuda/fattn-sparse.cu; keep the two in sync.

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable

#define WGS    256
#define TILE    32
#define HCHUNK  16
#define TPH    (WGS/HCHUNK)  // threads per head (16)
#define DK     512
#define DV     512
#define D4     (DK/4)        // f16vec4 per row
#define DPT    (DK/TPH)      // dims per thread in the dot product (32)
#define VPT    (DV/TPH)      // dims per thread in the V accumulate (32)
#define M_INIT (-1.0e30)

layout(local_size_x = WGS, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer Q    { float      data_q[];    };
layout (binding = 1) readonly buffer K    { f16vec4    data_k4[];   };
layout (binding = 2) readonly buffer M    { float16_t  data_m[];    };
layout (binding = 3) readonly buffer S    { float      data_s[];    };
layout (binding = 4) readonly buffer KC   { f16vec4    data_kc4[];  };
layout (binding = 5) readonly buffer IDX  { int        data_idx[];  };
layout (binding = 6) readonly buffer NVIS { int        data_nvis[]; };
layout (binding = 7) writeonly buffer O   { float      data_o[];    };

layout (push_constant) uniform parameter {
    float scale;
    uint  ne_dense;   // dense KV rows
    uint  n_idx;      // gathered candidates per token
    uint  n_head;
    uint  q_s1;       // Q strides in elements: token, head, stream
    uint  q_s2;
    uint  q_s3;
    uint  k_s1;       // dense K row / stream strides in elements
    uint  k_s3;
    uint  m_s1;       // mask token / stream strides in elements
    uint  m_s3;
    uint  c_s1;       // kc row / stream strides in elements
    uint  c_s3;
    uint  i_s1;       // idx token / stream strides in elements
    uint  i_s3;
    uint  n_s3;       // nvis stream stride in elements
    uint  flags;      // bit 0: has mask, bit 1: has sinks
} p;

shared f16vec4 Kt[TILE][D4];
shared float   Pt[HCHUNK][TILE];
shared uint    row_ok[TILE];

void main() {
    const uint t   = gl_WorkGroupID.x;   // query token
    const uint hc  = gl_WorkGroupID.y;   // head chunk
    const uint s   = gl_WorkGroupID.z;   // stream
    const uint T   = gl_NumWorkGroups.x;

    const uint tid  = gl_LocalInvocationID.x;
    const uint hl   = tid / TPH;
    const uint lane = tid % TPH;
    const uint h    = hc*HCHUNK + hl;
    const bool h_ok = h < p.n_head;

    const bool has_mask  = (p.flags & 1u) != 0u;
    const bool has_sinks = (p.flags & 2u) != 0u;

    // Q slice, pre-scaled
    float Qr[DPT];
    if (h_ok) {
        const uint q_base = t*p.q_s1 + h*p.q_s2 + s*p.q_s3 + lane*DPT;
        [[unroll]] for (uint i = 0; i < DPT; ++i) {
            Qr[i] = data_q[q_base + i]*p.scale;
        }
    } else {
        [[unroll]] for (uint i = 0; i < DPT; ++i) {
            Qr[i] = 0.0;
        }
    }

    float Or[VPT];
    [[unroll]] for (uint i = 0; i < VPT; ++i) {
        Or[i] = 0.0;
    }

    // running softmax state. Every lane of a head derives these from the same
    // cross-lane reductions, so they stay identical across the head's TPH lanes
    // and can live in registers instead of shared memory.
    float M_run   = float(M_INIT);
    float L_run   = 0.0;
    float m_scale = 1.0;   // exp(M_old - M_new) for the current tile

    const uint m_base = t*p.m_s1 + s*p.m_s3;
    const uint i_base = t*p.i_s1 + s*p.i_s3;
    const int  n_vis  = data_nvis[t + s*p.n_s3];

    const uint n_tiles_dense  = (p.ne_dense + TILE - 1)/TILE;
    const uint n_tiles_gather = (p.n_idx    + TILE - 1)/TILE;
    const uint n_tiles        = n_tiles_dense + n_tiles_gather;

    [[dont_unroll]] for (uint tile = 0; tile < n_tiles; ++tile) {
        const bool gather = tile >= n_tiles_dense;
        const uint base   = gather ? (tile - n_tiles_dense)*TILE : tile*TILE;
        const uint limit  = gather ? p.n_idx : p.ne_dense;

        // stage TILE rows into LDS: 8 threads per row, f16vec4 chunks
        {
            const uint TPR = WGS/TILE; // threads per row
            const uint r   = tid / TPR;
            const uint c0  = tid % TPR;

            bool ok = base + r < limit;
            uint src4 = 0u;
            if (ok) {
                if (gather) {
                    const int cell = data_idx[i_base + base + r];
                    ok = cell >= 0 && cell < n_vis;
                    if (ok) {
                        src4 = (uint(cell)*p.c_s1 + s*p.c_s3)/4u;
                    }
                } else {
                    src4 = ((base + r)*p.k_s1 + s*p.k_s3)/4u;
                }
            }
            // one leader per row writes the flag unconditionally, so no
            // zero-init pass (and no extra barrier) is needed
            if (c0 == 0u) {
                row_ok[r] = ok ? 1u : 0u;
            }
            if (ok) {
                [[unroll]] for (uint c = c0; c < D4; c += TPR) {
                    Kt[r][c] = gather ? data_kc4[src4 + c] : data_k4[src4 + c];
                }
            }
        }
        barrier();

        // scores: TPH lanes cooperate on each row's DK-dim dot product
        for (uint j = 0; j < TILE; ++j) {
            float sum = 0.0;
            if (h_ok && row_ok[j] != 0u) {
                [[unroll]] for (uint i = 0; i < DPT/4; ++i) {
                    const vec4 kv4 = vec4(Kt[j][lane*(DPT/4) + i]);
                    sum += Qr[4*i + 0]*kv4.x + Qr[4*i + 1]*kv4.y + Qr[4*i + 2]*kv4.z + Qr[4*i + 3]*kv4.w;
                }
            }
            sum += subgroupShuffleXor(sum, 8u);
            sum += subgroupShuffleXor(sum, 4u);
            sum += subgroupShuffleXor(sum, 2u);
            sum += subgroupShuffleXor(sum, 1u);
            if (lane == 0u) {
                float sc = sum;
                if (row_ok[j] == 0u) {
                    sc = uintBitsToFloat(0xFF800000); // -inf
                } else if (!gather && has_mask) {
                    // -inf mask entries flow through: exp(-inf - M) == 0 and
                    // max() against M_INIT keeps M finite (no NaN paths)
                    sc += float(data_m[m_base + base + j]);
                }
                Pt[hl][j] = sc;
            }
        }
        barrier();

        // per-head online softmax update — the TPH lanes of a head split the
        // TILE rows between them, so every thread works (doing this on
        // thread<HCHUNK left 15/16 of the workgroup stalled at the barrier)
        {
            float tmax = float(M_INIT);
            [[unroll]] for (uint j = lane; j < TILE; j += TPH) {
                tmax = max(tmax, Pt[hl][j]);
            }
            tmax = max(tmax, subgroupShuffleXor(tmax, 8u));
            tmax = max(tmax, subgroupShuffleXor(tmax, 4u));
            tmax = max(tmax, subgroupShuffleXor(tmax, 2u));
            tmax = max(tmax, subgroupShuffleXor(tmax, 1u));

            const float Mnew = max(M_run, tmax);
            const float ms   = exp(M_run - Mnew);

            float l_add = 0.0;
            [[unroll]] for (uint j = lane; j < TILE; j += TPH) {
                const float pv = exp(Pt[hl][j] - Mnew);
                Pt[hl][j] = pv;
                l_add += pv;
            }
            l_add += subgroupShuffleXor(l_add, 8u);
            l_add += subgroupShuffleXor(l_add, 4u);
            l_add += subgroupShuffleXor(l_add, 2u);
            l_add += subgroupShuffleXor(l_add, 1u);

            M_run = Mnew;
            L_run = L_run*ms + l_add;
            m_scale = ms;
        }
        barrier();

        // accumulate O — each thread owns a VPT-dim slice of one head
        {
            const float ms = m_scale;
            if (ms != 1.0) {
                [[unroll]] for (uint i = 0; i < VPT; ++i) {
                    Or[i] *= ms;
                }
            }
            for (uint j = 0; j < TILE; ++j) {
                const float pv = Pt[hl][j];
                if (pv == 0.0) {
                    continue;
                }
                [[unroll]] for (uint i = 0; i < VPT/4; ++i) {
                    const vec4 vv = vec4(Kt[j][lane*(VPT/4) + i]);
                    Or[4*i + 0] += pv*vv.x;
                    Or[4*i + 1] += pv*vv.y;
                    Or[4*i + 2] += pv*vv.z;
                    Or[4*i + 3] += pv*vv.w;
                }
            }
        }
        barrier();
    }

    if (!h_ok) {
        return;
    }

    // sinks — every lane of the head holds the same running state already
    float ms_f = 1.0;
    if (has_sinks) {
        const float sk   = data_s[h];
        const float Mnew = max(M_run, sk);
        ms_f  = exp(M_run - Mnew);
        L_run = L_run*ms_f + exp(sk - Mnew);
    }

    const float li = L_run == 0.0 ? 0.0 : 1.0/L_run;

    // dst is contiguous f32 [DV, n_head, T, ns]
    const uint o_base = DV*(h + p.n_head*(t + T*s)) + lane*VPT;
    [[unroll]] for (uint i = 0; i < VPT; ++i) {
        data_o[o_base + i] = Or[i]*ms_f*li;
    }
}
